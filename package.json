{
  "name": "noisemaker-for-hydra-synth",
  "version": "2.0.0-dev.0",
  "description": "Hydra effects ported natively to the Noisemaker shader engine",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "browser": "./dist/hydra-synth.js"
    },
    "./src/glsl/glsl-functions.js": {
      "import": "./src/glsl/glsl-functions.js"
    }
  },
  "unpkg": "./dist/hydra-synth.js",
  "scripts": {
    "dev": "http-server -p 8765",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs && node scripts/test.mjs"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "webgpu",
    "graphics",
    "livecoding",
    "synth",
    "noisemaker"
  ],
  "author": "ojack",
  "license": "AGPL",
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1"
  }
}
